#!/usr/bin/env bash
# Runs the test suite before every commit. Enable once per clone with:
#   git config core.hooksPath .githooks
# Skip in an emergency with: git commit --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 1
echo "pre-commit: running tests (make -C tests)..."
if make -s -C tests; then
   make -s -C tests clean >/dev/null 2>&1
   exit 0
fi
make -s -C tests clean >/dev/null 2>&1
echo "pre-commit: tests failed - commit aborted (use --no-verify to override)."
exit 1
